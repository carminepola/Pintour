---
import Icon from './Icon.astro';
import { company, navKeys } from '../i18n/data';
import { useTranslations } from '../i18n/translations';
import { languageNames, languageFlags, LANGUAGES, pathFor, LOGO_URL, LOGO_MARK_URL, navLabelKey } from '../i18n/config';
import type { Language, PageKey } from '../i18n/config';

interface Props {
  lang: Language;
  page: PageKey;
}
const { lang, page } = Astro.props;
const t = useTranslations(lang);
const navItems = navKeys.map((id) => ({ id, label: t.nav[navLabelKey[id]] }));
---
<div data-site-header class="sticky top-0 z-50">
  {/* Top bar - contatti + lingua */}
  <div class="bg-[#0f2540] text-white text-xs sm:text-sm">
    <div class="max-w-7xl mx-auto px-4 py-2 flex justify-between items-center gap-3">
      <div data-nosnippet class="flex items-center gap-4 sm:gap-6 min-w-0">
        <a href={`tel:${company.phone2.replace(/\s/g, '')}`} class="flex items-center gap-2 hover:text-[#0f4c81] transition-colors whitespace-nowrap">
          <Icon name="phone" class="w-3.5 h-3.5 flex-shrink-0" /><span class="hidden sm:inline">{company.phone2}</span>
        </a>
        <a href={`mailto:${company.email}`} class="flex items-center gap-2 hover:text-[#0f4c81] transition-colors min-w-0 truncate">
          <Icon name="mail" class="w-3.5 h-3.5 flex-shrink-0" /><span class="truncate">{company.email}</span>
        </a>
      </div>
      <div class="relative flex-shrink-0">
        <button data-lang-toggle class="flex items-center gap-2 hover:text-[#0f4c81] transition-colors whitespace-nowrap">
          <Icon name="globe" class="w-3.5 h-3.5" />
          <span>{languageFlags[lang]} <span class="hidden sm:inline">{languageNames[lang]}</span></span>
          <Icon name="chevronDown" class="w-3 h-3 lang-chevron transition-transform" />
        </button>
        <div data-lang-menu class="lang-dropdown absolute right-0 top-full mt-1 bg-white text-[#0f2540] rounded-lg shadow-xl py-1 min-w-[160px] z-50">
          {LANGUAGES.map((l) => (
            <a href={pathFor(l, page)} class={`w-full px-4 py-2 text-left flex items-center gap-2 hover:bg-[#eef3f8] transition-colors ${lang === l ? 'font-bold bg-[#eef3f8]/50' : ''}`}>
              <span>{languageFlags[l]}</span><span>{languageNames[l]}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>

  {/* Main header - logo + nav */}
  <header id="site-header" class="transition-all duration-300 bg-white shadow-md">
    <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between gap-4">
      <a href={pathFor(lang, 'home')} class="flex-shrink-0 flex items-center gap-2.5">
        <img src={LOGO_MARK_URL} alt="Pintour" class="h-9 md:h-10 w-auto" />
        <img src={LOGO_URL} alt="Pintour" class="hidden sm:block h-6 md:h-7 w-auto" />
      </a>

      {/* Desktop navigation - una sola riga, visibile da lg */}
      <nav class="hidden lg:flex items-center gap-1 justify-center flex-1">
        {navItems.map((item) => (
          <a href={pathFor(lang, item.id)} class={`px-4 py-2 rounded-md text-sm font-semibold transition-all duration-200 whitespace-nowrap ${page === item.id ? 'bg-[#0f2540] text-white' : 'text-[#0f2540] hover:bg-[#eef3f8]'}`}>{item.label}</a>
        ))}
      </nav>

      {/* Mobile/tablet hamburger (< lg) - la lingua è già nella top bar */}
      <div class="flex items-center gap-2 lg:hidden flex-shrink-0">
        <button data-menu-toggle class="p-2 rounded-lg hover:bg-[#eef3f8] transition-colors text-[#0f2540]" aria-label="Toggle menu">
          <Icon name="menu" class="w-6 h-6" />
        </button>
      </div>
    </div>

    {/* Mobile/tablet menu (< lg) */}
    <div data-mobile-menu class="mobile-menu lg:hidden">
      <nav class="px-4 pb-4 space-y-1 border-t border-[#e5e7eb]">
        {navItems.map((item) => (
          <a href={pathFor(lang, item.id)} class={`w-full text-left px-4 py-3 rounded-lg text-sm font-semibold transition-all duration-200 block ${page === item.id ? 'bg-[#0f2540] text-white' : 'text-[#0f2540] hover:bg-[#eef3f8]'}`}>{item.label}</a>
        ))}
        <div data-nosnippet class="pt-3 border-t border-[#e5e7eb] flex flex-col gap-2 text-sm text-[#0f2540]">
          <a href={`tel:${company.phone2.replace(/\s/g, '')}`} class="flex items-center gap-2 px-4 py-2 hover:text-[#0f4c81]"><Icon name="phone" class="w-4 h-4" /> {company.phone2}</a>
          <a href={`mailto:${company.email}`} class="flex items-center gap-2 px-4 py-2 hover:text-[#0f4c81]"><Icon name="mail" class="w-4 h-4" /> {company.email}</a>
        </div>
      </nav>
    </div>
  </header>
</div>
