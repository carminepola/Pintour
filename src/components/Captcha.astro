---
// Widget captcha (math challenge firmato lato server). Compilato dal client script.
---
<div data-captcha class="rounded-xl bg-[#f8fafc] border border-[#e2e8f0] p-4">
  <div class="flex items-center justify-between gap-3 mb-3">
    <div class="flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#25867f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 flex-shrink-0"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/></svg>
      <span data-captcha-text class="text-sm font-medium text-[#1a1064]"></span>
    </div>
    <button type="button" data-captcha-refresh class="text-[#25867f] hover:text-[#1f6b65] text-lg leading-none px-1" aria-label="refresh">↻</button>
  </div>
  <input type="number" name="captchaAnswer" inputmode="numeric" required class="w-full px-4 py-2.5 rounded-lg border border-[#e2e8f0] bg-white focus:border-[#1a1064] focus:ring-2 focus:ring-[#1a1064]/20 outline-none transition-all text-sm" />
  <input type="hidden" name="captchaId" data-captcha-id />
  <p data-captcha-err class="hidden text-xs text-red-600 mt-2"></p>
</div>
