---
import Icon from '../components/Icon.astro';
import { useTranslations } from '../i18n/translations';
import { vehicles as fleet } from '../i18n/data';
import type { Language } from '../i18n/config';

interface Props { lang: Language; }
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<div>
  <section data-reveal class="corp-hero">
    <div class="max-w-7xl mx-auto px-4 py-20 md:py-28">
      <div class="max-w-3xl">
        <div class="flex items-center gap-2 text-white/70 text-sm mb-6">
          <span>{t.nav.home}</span><Icon name="chevronRight" class="w-4 h-4" /><span class="text-white font-medium">{t.rental.breadcrumbRental}</span>
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-white mb-4">{t.rental.heroTitle}</h1>
        <p class="text-lg text-white/80 max-w-xl">{t.rental.description}</p>
      </div>
    </div>
  </section> 

  <section data-reveal class="py-16 md:py-20 bg-[#eef3f8]/20">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-2xl md:text-3xl font-bold text-[#0f2540] mb-2">{t.rental.fleetTitle}</h2>
        <p class="text-gray-600">{t.rental.fleetSubtitle}</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {fleet.map((item) => (
          <div class="card-hover bg-white rounded-lg border border-[#e5e7eb] overflow-hidden group">
            <div class="relative h-44 overflow-hidden bg-[#eef3f8]">
              <img src={item.image} alt={t.rental.vehicles[item.key]} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              {item.count && <span class="absolute top-3 right-3 bg-white/95 text-[#0f2540] text-xs font-semibold px-2.5 py-1 rounded-md">×{item.count}</span>}
            </div>
            <div class="p-5">
              <div class="flex items-center gap-2 mb-2">
                <div class="w-8 h-8 rounded-md bg-[#0f4c81]/10 flex items-center justify-center"><Icon name={item.icon} class="w-4 h-4 text-[#0f4c81]" /></div>
                <h3 class="font-bold text-[#0f2540] text-sm">{t.rental.vehicles[item.key]}</h3>
              </div>
              <p class="text-xs text-gray-600 leading-relaxed">{t.rental.vehicles[`${item.key}Desc` as keyof typeof t.rental.vehicles]}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section data-reveal class="py-16 md:py-24 bg-white">
    <div class="max-w-3xl mx-auto px-4">
      <div class="text-center mb-10">
        <h2 class="text-2xl md:text-3xl font-bold text-[#0f2540] mb-2">{t.rental.quoteTitle}</h2>
        <p class="text-gray-600">{t.rental.quoteSubtitle}</p>
      </div>
      <div data-form-success class="hidden text-center py-12 bg-[#eef3f8]/30 rounded-lg">
        <Icon name="checkCircle" class="w-16 h-16 text-[#0f4c81] mx-auto mb-4" />
        <h3 class="text-xl font-bold text-[#0f2540] mb-2">{t.rental.successTitle}</h3>
        <p class="text-gray-600">{t.rental.successDesc}</p>
      </div>
      <p class="text-sm text-gray-500 mb-4">{t.common.shuttleRoutesNote} <a href="https://shuttlebus.pintourbus.com" target="_blank" rel="noopener" class="text-[#0f4c81] font-semibold hover:underline">{t.common.shuttleRoutesLink}</a></p>
      <form data-demo-form class="space-y-5">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div><label class="block text-sm font-medium text-[#0f2540] mb-1.5">{t.rental.formName}</label><input type="text" required class="w-full px-4 py-3 rounded-xl border border-[#e5e7eb] focus:border-[#0f2540] focus:ring-2 focus:ring-[#0f2540]/20 outline-none transition-all text-sm" /></div>
          <div><label class="block text-sm font-medium text-[#0f2540] mb-1.5">{t.rental.formEmail}</label><input type="email" required class="w-full px-4 py-3 rounded-xl border border-[#e5e7eb] focus:border-[#0f2540] focus:ring-2 focus:ring-[#0f2540]/20 outline-none transition-all text-sm" /></div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
          <div><label class="block text-sm font-medium text-[#0f2540] mb-1.5">{t.rental.formPhone}</label><input type="tel" class="w-full px-4 py-3 rounded-xl border border-[#e5e7eb] focus:border-[#0f2540] focus:ring-2 focus:ring-[#0f2540]/20 outline-none transition-all text-sm" /></div>
          <div><label class="block text-sm font-medium text-[#0f2540] mb-1.5">{t.rental.formDate}</label><input type="date" class="w-full px-4 py-3 rounded-xl border border-[#e5e7eb] focus:border-[#0f2540] focus:ring-2 focus:ring-[#0f2540]/20 outline-none transition-all text-sm" /></div>
          <div><label class="block text-sm font-medium text-[#0f2540] mb-1.5">{t.rental.formPassengers}</label><input type="number" class="w-full px-4 py-3 rounded-xl border border-[#e5e7eb] focus:border-[#0f2540] focus:ring-2 focus:ring-[#0f2540]/20 outline-none transition-all text-sm" /></div>
        </div>
        <div><label class="block text-sm font-medium text-[#0f2540] mb-1.5">{t.rental.formMessage}</label><textarea rows="4" class="w-full px-4 py-3 rounded-xl border border-[#e5e7eb] focus:border-[#0f2540] focus:ring-2 focus:ring-[#0f2540]/20 outline-none transition-all text-sm resize-none"></textarea></div>
        <div class="flex items-start gap-3">
          <input type="checkbox" required class="mt-1 w-4 h-4 rounded border-[#e5e7eb] text-[#0f2540] focus:ring-[#0f2540]" />
          <label class="text-xs text-gray-600 leading-relaxed">{t.rental.formPrivacy}</label>
        </div>
        <button type="submit" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-[#0f4c81] text-white font-bold rounded-md hover:bg-[#0a3a62] transition-all text-sm"><Icon name="send" class="w-4 h-4" />{t.rental.formSubmit}</button>
      </form>
    </div>
  </section>
</div>
