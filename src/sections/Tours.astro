---
import Icon from '../components/Icon.astro';
import Captcha from '../components/Captcha.astro';
import { useTranslations } from '../i18n/translations';
import { HERO_IMG } from '../i18n/config';
import { destinations, regionOrder, company } from '../i18n/data';
import type { Language } from '../i18n/config';

interface Props { lang: Language; }
const { lang } = Astro.props;
const t = useTranslations(lang);

const filters = [
  { key: 'all', label: t.tours.filters.all },
  ...regionOrder.map((r) => ({ key: r, label: t.tours.filters[r] })),
];
---
<div>
  <section class="relative py-24 md:py-32 overflow-hidden">
    <div class="absolute inset-0">
      <img src={HERO_IMG} alt="Tours" class="w-full h-full object-cover" />
      <div class="hero-gradient-dark absolute inset-0"></div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-4">
      <div class="max-w-2xl">
        <div class="flex items-center gap-2 text-white/70 text-sm mb-6">
          <span>{t.nav.home}</span><Icon name="chevronRight" class="w-4 h-4" /><span class="text-white font-medium">{t.nav.tours}</span>
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-white mb-4">{t.tours.heroTitle}</h1>
        <p class="text-base md:text-lg text-[#d9f3ff] uppercase tracking-wider font-bold mb-3">{t.tours.heroSubtitle}</p>
        <p class="text-base md:text-lg text-white/85 max-w-xl leading-relaxed">{t.tours.heroDesc}</p>
        <a href="#quote" class="mt-8 inline-flex items-center justify-center gap-2 px-8 py-4 bg-[#ec2a7a] text-white font-bold rounded-full hover:bg-[#d4236a] transition-all hover:scale-105 text-sm md:text-base">{t.tours.bookCta}<Icon name="arrowRight" class="w-4 h-4" /></a>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-10">
        <h2 class="text-3xl md:text-4xl font-bold text-[#1a1064] mb-3">{t.tours.sectionTitle}</h2>
        <p class="text-gray-600">{t.tours.sectionSubtitle}</p>
      </div>

      <div class="flex flex-wrap justify-center gap-3 mb-10">
        {filters.map((f, i) => (
          <button data-tour-filter={f.key} class={`tour-filter px-5 py-2.5 rounded-full font-semibold text-sm transition-all ${i === 0 ? 'bg-[#1a1064] text-white' : 'bg-[#d9f3ff]/40 text-[#1a1064] hover:bg-[#d9f3ff]'}`}>{f.label}</button>
        ))}
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {destinations.map((d) => (
          <div data-tour-card data-region={d.region} class="bg-white rounded-2xl overflow-hidden shadow-lg border border-[#e2e8f0] flex flex-col">
            <div class="relative h-44 flex items-center justify-center" style={`background: linear-gradient(135deg, ${d.from}, ${d.to})`}>
              <span class="text-7xl drop-shadow-lg">{d.emoji}</span>
              <span class="absolute top-3 right-3 bg-white/90 text-[#1a1064] text-xs font-bold px-3 py-1 rounded-full">{t.tours.from} {d.priceFrom}</span>
            </div>
            <div class="p-5 flex flex-col flex-1">
              <h3 class="text-lg font-bold text-[#1a1064] mb-1">{t.tours.destinations[`${d.key}` as keyof typeof t.tours.destinations]}</h3>
              <div class="flex items-center gap-1.5 text-xs text-gray-500 mb-2"><Icon name="clock" class="w-3.5 h-3.5" /><span>{t.tours.duration[d.durationKey]}</span></div>
              <p class="text-sm text-gray-600 leading-relaxed flex-1">{t.tours.destinations[`${d.key}Desc` as keyof typeof t.tours.destinations]}</p>
              <a href="#quote" class="mt-4 inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-[#ec2a7a] text-white text-sm font-bold rounded-full hover:bg-[#d4236a] transition-all" data-tour-pick={t.tours.destinations[`${d.key}` as keyof typeof t.tours.destinations]}>{t.tours.requestQuote}<Icon name="arrowRight" class="w-4 h-4" /></a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="quote" class="py-16 md:py-24 bg-[#d9f3ff]/30 scroll-mt-24">
    <div class="max-w-3xl mx-auto px-4">
      <div class="text-center mb-10">
        <h2 class="text-3xl md:text-4xl font-bold text-[#1a1064] mb-3">{t.tours.quoteTitle}</h2>
        <p class="text-gray-600">{t.tours.quoteSubtitle}</p>
      </div>
      <div class="bg-white rounded-2xl p-6 md:p-8 shadow-xl border border-[#d9f3ff]">
        <div data-form-success class="hidden text-center py-12">
          <Icon name="checkCircle" class="w-16 h-16 text-[#25867f] mx-auto mb-4" />
          <h3 class="text-xl font-bold text-[#1a1064] mb-2">{t.tours.successTitle}</h3>
          <p class="text-gray-600">{t.tours.successDesc}</p>
        </div>
        <form data-form="quote" class="space-y-5">
          <div class="hidden" aria-hidden="true"><label>Lascia vuoto questo campo<input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div><label class="block text-sm font-medium text-[#1a1064] mb-1.5">{t.tours.formName}</label><input name="name" type="text" required class="w-full px-4 py-3 rounded-xl border border-[#e2e8f0] bg-white focus:border-[#1a1064] focus:ring-2 focus:ring-[#1a1064]/20 outline-none transition-all text-sm" /></div>
            <div><label class="block text-sm font-medium text-[#1a1064] mb-1.5">{t.tours.formEmail}</label><input name="email" type="email" required class="w-full px-4 py-3 rounded-xl border border-[#e2e8f0] bg-white focus:border-[#1a1064] focus:ring-2 focus:ring-[#1a1064]/20 outline-none transition-all text-sm" /></div>
            <div><label class="block text-sm font-medium text-[#1a1064] mb-1.5">{t.tours.formPhone}</label><input name="phone" type="tel" class="w-full px-4 py-3 rounded-xl border border-[#e2e8f0] bg-white focus:border-[#1a1064] focus:ring-2 focus:ring-[#1a1064]/20 outline-none transition-all text-sm" /></div>
            <div><label class="block text-sm font-medium text-[#1a1064] mb-1.5">{t.tours.formDestination}</label><input id="tour-dest" name="destination" type="text" class="w-full px-4 py-3 rounded-xl border border-[#e2e8f0] bg-white focus:border-[#1a1064] focus:ring-2 focus:ring-[#1a1064]/20 outline-none transition-all text-sm" /></div>
            <div><label class="block text-sm font-medium text-[#1a1064] mb-1.5">{t.tours.formDate}</label><input name="date" type="date" class="w-full px-4 py-3 rounded-xl border border-[#e2e8f0] bg-white focus:border-[#1a1064] focus:ring-2 focus:ring-[#1a1064]/20 outline-none transition-all text-sm" /></div>
            <div><label class="block text-sm font-medium text-[#1a1064] mb-1.5">{t.tours.formPassengers}</label><input name="passengers" type="number" min="1" class="w-full px-4 py-3 rounded-xl border border-[#e2e8f0] bg-white focus:border-[#1a1064] focus:ring-2 focus:ring-[#1a1064]/20 outline-none transition-all text-sm" /></div>
          </div>
          <div><label class="block text-sm font-medium text-[#1a1064] mb-1.5">{t.tours.formMessage}</label><textarea name="message" rows="4" class="w-full px-4 py-3 rounded-xl border border-[#e2e8f0] bg-white focus:border-[#1a1064] focus:ring-2 focus:ring-[#1a1064]/20 outline-none transition-all text-sm resize-none"></textarea></div>
          <Captcha />
          <p data-form-error class="hidden text-sm text-red-600"></p>
          <div class="flex items-start gap-3">
            <input type="checkbox" required class="mt-1 w-4 h-4 rounded border-[#e2e8f0] text-[#1a1064] focus:ring-[#1a1064]" />
            <label class="text-xs text-gray-600 leading-relaxed">{t.tours.formPrivacy}</label>
          </div>
          <button type="submit" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-[#ec2a7a] text-white font-bold rounded-full hover:bg-[#d4236a] transition-all hover:scale-105 text-sm"><Icon name="send" class="w-4 h-4" />{t.tours.formSubmit}</button>
        </form>
      </div>
    </div>
  </section>

  <section class="py-10 bg-white">
    <div class="max-w-3xl mx-auto px-4 flex flex-col sm:flex-row gap-4 justify-center">
      <a href={`https://wa.me/${company.whatsapp}`} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-[#25867f] text-white font-semibold rounded-full hover:bg-[#1f6b65] transition-all text-sm"><Icon name="messageCircle" class="w-5 h-5" />WhatsApp</a>
      <a href={`tel:${company.phone1.replace(/\s/g,'')}`} class="inline-flex items-center justify-center gap-2 px-6 py-3 border-2 border-[#1a1064] text-[#1a1064] font-semibold rounded-full hover:bg-[#1a1064] hover:text-white transition-all text-sm"><Icon name="phone" class="w-5 h-5" />{company.phone1}</a>
    </div>
  </section>
</div>

<script>
  document.querySelectorAll('[data-tour-filter]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      const cat = btn.getAttribute('data-tour-filter');
      document.querySelectorAll('[data-tour-filter]').forEach(function (b) {
        b.className = 'tour-filter px-5 py-2.5 rounded-full font-semibold text-sm transition-all bg-[#d9f3ff]/40 text-[#1a1064] hover:bg-[#d9f3ff]';
      });
      btn.className = 'tour-filter px-5 py-2.5 rounded-full font-semibold text-sm transition-all bg-[#1a1064] text-white';
      document.querySelectorAll('[data-tour-card]').forEach(function (card) {
        const region = card.getAttribute('data-region');
        (card as HTMLElement).style.display = (cat === 'all' || region === cat) ? '' : 'none';
      });
    });
  });
  document.querySelectorAll('[data-tour-pick]').forEach(function (link) {
    link.addEventListener('click', function () {
      const dest = link.getAttribute('data-tour-pick');
      const input = document.getElementById('tour-dest');
      if (input && dest) (input as HTMLInputElement).value = dest;
    });
  });
</script>
