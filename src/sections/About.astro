---
import Icon from '../components/Icon.astro';
import { useTranslations } from '../i18n/translations';
import { MOBILITY_CHARTER_URL } from '../i18n/config';
import { company } from '../i18n/data';
import { getExperienceYearsString } from '../utils/experience';
import type { Language } from '../i18n/config';

interface Props { lang: Language; }
const { lang } = Astro.props;
const t = useTranslations(lang);

const experienceYears = getExperienceYearsString();

const features = [
  { icon: 'shield', color: '#0f2540', title: t.about.feat1Title, desc: t.about.feat1Desc },
  { icon: 'award', color: '#0f4c81', title: t.about.feat2Title, desc: t.about.feat2Desc },
  { icon: 'users', color: '#0f4c81', title: t.about.feat3Title, desc: t.about.feat3Desc },
  { icon: 'shield', color: '#1c3a55', title: t.about.feat4Title.replace('{years}', experienceYears.replace('+', '')), desc: t.about.feat4Desc },
];
---
<div>
  <section data-reveal class="corp-hero">
    <div class="max-w-7xl mx-auto px-4 py-20 md:py-28">
      <div class="max-w-3xl">
        <div class="flex items-center gap-2 text-white/70 text-sm mb-6">
          <span>{t.about.breadcrumbHome}</span><Icon name="chevronRight" class="w-4 h-4" /><span class="text-white font-medium">{t.about.breadcrumbAbout}</span>
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-white mb-4">{t.about.heroTitle}</h1>
      </div>
    </div>
  </section>

  <section data-reveal class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <div class="lg:col-span-2 space-y-8">
          <div>
            <h2 class="text-2xl md:text-3xl font-bold text-[#0f2540] mb-6 accent-underline">Pintour S.C.A.R.L.</h2>
            <p class="text-gray-700 leading-relaxed text-base md:text-lg">{t.about.paragraph1}</p>
          </div>
          <div class="bg-[#0f2540] rounded-lg p-8 text-white">
            <p class="text-lg md:text-xl font-bold text-center">{t.about.paragraph2}</p>
          </div>
          <p class="text-gray-700 leading-relaxed text-base md:text-lg">{t.about.paragraph3}</p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-8">
            {features.map((f) => (
              <div class="flex items-start gap-3 p-4 bg-[#eef3f8]/30 rounded-xl">
                <div class="w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0" style={`background-color:${f.color}`}><Icon name={f.icon} class="w-5 h-5 text-white" /></div>
                <div><h4 class="font-bold text-[#0f2540] text-sm">{f.title}</h4><p class="text-xs text-gray-600">{f.desc}</p></div>
              </div>
            ))}
          </div>
        </div>
        <div class="space-y-6">
          <div class="bg-[#0f2540] rounded-lg p-6 text-white">
            <h3 class="text-lg font-bold mb-3">{t.about.mobilityCard}</h3>
            <p class="text-sm text-white/80 mb-4 leading-relaxed">{t.about.mobilityCardDesc}</p>
            <a href={MOBILITY_CHARTER_URL} download class="inline-flex items-center gap-2 px-5 py-2.5 bg-[#0f4c81] text-white font-semibold rounded-md hover:bg-[#0a3a62] transition-colors text-sm"><Icon name="download" class="w-4 h-4" />{t.about.download}</a>
          </div>
          <div class="bg-[#eef3f8]/30 rounded-lg p-6 border border-[#eef3f8]">
            <h3 class="text-lg font-bold text-[#0f2540] mb-4">{t.about.sidebarTitle}</h3>
            <div class="space-y-3 text-sm">
              <div><p class="font-semibold text-[#0f2540]">{t.contacts.legalHQ}</p><p class="text-gray-600">{company.legalHQ.street}, {company.legalHQ.city}</p></div>
              <div><p class="font-semibold text-[#0f2540]">{t.contacts.operationalHQ}</p><p class="text-gray-600">{company.operationalHQ.street}, {company.operationalHQ.city}</p></div>
              <div class="pt-2 border-t border-[#eef3f8]">
                <a href={`tel:${company.phone1.replace(/\s/g,'')}`} class="block text-[#0f4c81] font-medium hover:underline">{company.phone1}</a>
                <a href={`tel:${company.phone2.replace(/\s/g,'')}`} class="block text-[#0f4c81] font-medium hover:underline">{company.phone2}</a>
                <a href={`mailto:${company.emailInfo}`} class="block text-[#0f4c81] font-medium hover:underline">{company.emailInfo}</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>
