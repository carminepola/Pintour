---
import Icon from '../components/Icon.astro';
import { useTranslations } from '../i18n/translations';
import { privacyContent } from '../i18n/privacy';
import type { Language } from '../i18n/config';

interface Props { lang: Language; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const blocks = privacyContent[lang];
---
<div>
  <section data-reveal class="corp-hero">
    <div class="max-w-7xl mx-auto px-4 py-20 md:py-28">
      <div class="max-w-3xl">
        <div class="flex items-center gap-2 text-white/70 text-sm mb-6">
          <span>{t.nav.home}</span><Icon name="chevronRight" class="w-4 h-4" /><span class="text-white font-medium">{t.footer.privacy}</span>
        </div>
        <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-3">{t.footer.privacy}</h1>
      </div>
    </div>
  </section>

  <section data-reveal class="py-16 md:py-20 bg-white">
    <div class="max-w-3xl mx-auto px-4 privacy-content">
      {blocks.map((b) => (
        <>
          {b.h2 && <h2>{b.h2}</h2>}
          {b.h3 && <h3>{b.h3}</h3>}
          {b.p && b.p.map((para) => <p set:html={para} />)}
          {b.ul && (
            <ul>
              {b.ul.map((li) => <li set:html={li} />)}
            </ul>
          )}
        </>
      ))}
    </div>
  </section>
</div>
